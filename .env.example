# Required for live contact search (Google results via Serper).
# Sign up at https://serper.dev
SERPER_API_KEY=

# Optional — "Quick contact guide" ranks emails from search results via OpenAI (no invented addresses).
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=

# Gmail OAuth (required for real Gmail connect/send/sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel: optional dedicated secret for signing the Gmail session cookie (falls back to GOOGLE_CLIENT_SECRET)
TOWNREACH_OAUTH_SECRET=
# Optional: defaults to http://localhost:3000/api/auth/gmail/callback in dev
GOOGLE_REDIRECT_URI=
# Optional base URL used for OAuth callback building
APP_BASE_URL=http://localhost:3000
