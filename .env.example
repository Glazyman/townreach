# Sign up at https://serper.dev
SERPER_API_KEY=0d9e6e2826d564c7ec0308a8189845545b57dc3e

# Gmail OAuth (required for real Gmail connect/send/sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel: optional dedicated secret for signing the Gmail session cookie (falls back to GOOGLE_CLIENT_SECRET)
