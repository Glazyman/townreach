# Required for live contact search (Google results via Serper).
# Sign up at https://serper.dev
SERPER_API_KEY=

# Gmail OAuth (required for real Gmail connect/send/sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to http://localhost:3000/api/auth/gmail/callback in dev
GOOGLE_REDIRECT_URI=
# Optional base URL used for OAuth callback building
APP_BASE_URL=http://localhost:3000
