# =============================================================================
# TownReach — Environment variables (copy to .env.local and fill in)
# =============================================================================


# -----------------------------------------------------------------------------
# Contact search
# -----------------------------------------------------------------------------
# Backend: Serper (Google-style results API) OR OpenAI (Responses API web_search).
#
#   serper  — Default. Needs SERPER_API_KEY. Uses Serper + same-site crawl.
#   openai  — Needs OPENAI_API_KEY only; OpenAI performs web search, then TownReach
#             fetches cited pages to extract emails (no hallucinated addresses).
#
CONTACT_SEARCH_PROVIDER=serper

# Sign up at https://serper.dev — required when CONTACT_SEARCH_PROVIDER=serper
SERPER_API_KEY=

# Required when CONTACT_SEARCH_PROVIDER=openai — also used for optional “guide” below.
OPENAI_API_KEY=

# Optional. Model for openai search path (defaults to gpt-4.1-mini in code).
# Must support OpenAI Responses + web_search on your account.
OPENAI_WEB_CONTACT_MODEL=

# Optional. Model for the “Chat-style guide” step only (defaults to gpt-4o-mini in code).
OPENAI_MODEL=


# -----------------------------------------------------------------------------
# Gmail OAuth (connect / send / sync)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Signing secret for Gmail session cookie (production). Falls back to GOOGLE_CLIENT_SECRET.
TOWNREACH_OAUTH_SECRET=

# Optional. Defaults to {APP_ORIGIN}/api/auth/gmail/callback in development.
GOOGLE_REDIRECT_URI=

# Optional. Base URL when building OAuth links (defaults to http://localhost:3000).
APP_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Supabase (optional — only if the app uses the Supabase client)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
