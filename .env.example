# Contact search backend: serper (default) or openai (OpenAI Responses API + hosted web_search; billed by OpenAI).
CONTACT_SEARCH_PROVIDER=serper

# Required when CONTACT_SEARCH_PROVIDER=serper — Google organic results via https://serper.dev
SERPER_API_KEY=

# Required when CONTACT_SEARCH_PROVIDER=openai — same key powers optional "Quick contact guide" below.
OPENAI_API_KEY=

# Optional — model for CONTACT_SEARCH_PROVIDER=openai (default gpt-4.1-mini; must support Responses + web_search on your tier).
OPENAI_WEB_CONTACT_MODEL=

# Optional — "Quick contact guide" ranks emails already found via Serper/OpenAI-web (no invented addresses).
# Optional model override for that step (default: gpt-4o-mini in code).
OPENAI_MODEL=

# Gmail OAuth (required for real Gmail connect/send/sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel: optional dedicated secret for signing the Gmail session cookie (falls back to GOOGLE_CLIENT_SECRET)
TOWNREACH_OAUTH_SECRET=
# Optional: defaults to http://localhost:3000/api/auth/gmail/callback in dev
GOOGLE_REDIRECT_URI=
# Optional base URL used for OAuth callback building
APP_BASE_URL=http://localhost:3000
